{
  "name": "qtrading",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python main.py",
    "install:all": "cd frontend && npm install",
    "build": "cd frontend && npm run build",
    "docker:up": "cd docker && docker-compose up -d",
    "docker:down": "cd docker && docker-compose down",
    "setup": "cp backend/.env.example backend/.env && cp frontend/.env.example frontend/.env.local && echo 'Setup complete! Edit backend/.env and frontend/.env.local with your API keys.'"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
