# QTrading Backend Environment Variables
# Copy this file to .env and fill in your values

# App Settings
APP_NAME=QTrading API
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://qtrading:qtrading@localhost:5432/qtrading

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Market Data API Keys (optional - falls back to mock data)
# Get free key at: https://polygon.io
POLYGON_API_KEY=

# Get free key at: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Get free key at: https://finnhub.io
FINNHUB_API_KEY=

# AI (OpenAI)
# Get key at: https://platform.openai.com
OPENAI_API_KEY=

# Data source: yfinance | polygon | alpaca | finnhub
DATA_SOURCE=yfinance

# Refresh interval in seconds
REFRESH_INTERVAL_SEC=1.5

# Paper Trading
PAPER_TRADING_INITIAL_BALANCE=50000.0
RISK_PER_TRADE_PCT=0.02
